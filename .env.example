# Copier ce fichier en .env (jamais commité, voir .gitignore) et renseigner les
# vraies valeurs. Toutes ces variables sont obligatoires au demarrage de
# l'application depuis l'etape 4 de la roadmap (voir CLAUDE.md).

# Postgres (dev local via docker-compose.yml)
POSTGRES_USER=guesschess
POSTGRES_PASSWORD=guesschess

# OAuth Google (Google Cloud Console -> APIs & Services -> Credentials)
# Redirect URI a declarer : http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth GitHub (Settings -> Developer settings -> OAuth Apps)
# Callback URL a declarer : http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret HMAC pour signer les JWT (>= 32 octets aleatoires)
# Generer avec : openssl rand -base64 32
JWT_SECRET=

# URL du frontend vers laquelle rediriger apres login (JWT en fragment d'URL)
OAUTH_POST_LOGIN_REDIRECT_URI=http://localhost:5173/oauth-callback

# Cookie d'identite anonyme : le defaut applicatif est "true" (fail-safe pour la prod).
# En dev local HTTP, doit rester a false, sinon le navigateur refuse le cookie.
ANONYMOUS_COOKIE_SECURE=false
