# Copier ce fichier en .env sur le Raspberry Pi (jamais commite, voir .gitignore et
# le guide de securite du .env : hors du dossier clone par le runner, chmod 600).
# Utilise par docker-compose.prod.yml.

# Postgres (reseau Docker interne uniquement, aucun port publie en prod)
POSTGRES_USER=guesschess
POSTGRES_PASSWORD=

# OAuth Google (Google Cloud Console -> APIs & Services -> Credentials)
# Redirect URI a declarer une fois le domaine choisi (etape 10) :
# https://<votre-domaine>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth GitHub (Settings -> Developer settings -> OAuth Apps)
# Callback URL a declarer une fois le domaine choisi (etape 10) :
# https://<votre-domaine>/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret HMAC pour signer les JWT (>= 32 octets aleatoires)
# Generer avec : openssl rand -base64 32
JWT_SECRET=

# URL du frontend vers laquelle rediriger apres login (JWT en fragment d'URL).
# A pointer vers le vrai domaine a l'etape 10 - ex. https://<votre-domaine>/oauth-callback
OAUTH_POST_LOGIN_REDIRECT_URI=http://localhost/oauth-callback

# Frontend et backend sont same-origin derriere nginx (voir frontend/nginx.conf),
# donc le navigateur ne fait plus de requete cross-origin en prod - sert de secours
# pour le CORS REST (accès direct au backend hors du proxy nginx), et est aussi
# reutilisee pour restreindre l'Origin autorisee au handshake WebSocket
# (WebSocketConfig) : a pointer vers le vrai domaine (https://<votre-domaine>).
CORS_ALLOWED_ORIGIN=http://localhost

# Cookie d'identite anonyme : necessite HTTPS pour le flag Secure. Laisser a false
# tant que Caddy/HTTPS n'est pas branche (etape 10), sinon le cookie est refuse par
# le navigateur et l'identite anonyme ne persiste pas.
ANONYMOUS_COOKIE_SECURE=false
