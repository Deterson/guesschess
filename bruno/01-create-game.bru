meta {
  name: 01 - Create game
  type: ws
  seq: 1
}

ws {
  url: ws://localhost:8080/ws
  body: ws
  auth: inherit
}

body:ws {
  name: 1. CONNECT
  type: text
  content: '''
    CONNECT
    accept-version:1.2
    host:localhost


  '''
}

body:ws {
  name: 2. SUBSCRIBE user queue games.created
  type: text
  content: '''
    SUBSCRIBE
    id:sub-0
    destination:/user/queue/games.created


  '''
}

body:ws {
  name: 3. SEND games.create
  type: text
  selected: true
  content: '''
    SEND
    destination:/app/games.create
    content-type:application/json
    content-length:25

    {"variant":"REGULAR"}

  '''
}

body:ws {
  name: 4. SEND games.create (guessmate)
  type: text
  content: '''
    SEND
    destination:/app/games.create
    content-type:application/json
    content-length:23

    {"variant":"GUESSMATE"}

  '''
}
